# ---------------------------------------------------------------------------
# CineVision — environment template
#
# Copy to `.env` and fill in the values. `.env` is git-ignored and must
# never be committed.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Telegram bot token issued by @BotFather.
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourOwn

# Kinopoisk API key (https://kinopoisk.dev) used by the film metadata provider.
FILMS_API_TOKEN=your-kinopoisk-api-key

# --- Optional -------------------------------------------------------------

# SQLAlchemy async connection URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite+aiosqlite:///data/movielib.db

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
